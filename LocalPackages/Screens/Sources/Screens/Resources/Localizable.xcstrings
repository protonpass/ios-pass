    "For security reasons, your access needs to be confirmed" : {
      "comment" : "New users have to wait for an admin to confirm his access to the shared vault",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У мэтах бяспекі вам неабходна пацвердзіць свой доступ"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per motius de seguretat, cal confirmar el vostre accés"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z bezpečnostních důvodů musí být váš přístup potvrzen"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af sikkerhedsmæssige årsager skal din adgang bekræftes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Sicherheitsgründen muss dein Zugriff bestätigt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για λόγους ασφαλείας, η πρόσβασή σας πρέπει να επιβεβαιωθεί"
