    "Securely in one place and protected by the most trusted name in privacy." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бяспечна ў адным месцы і абаронена самай надзейнай кампаніяй у галіне прыватнасці."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma segura en un sol lloc i protegit per l'empresa més fiable en matèria de privacitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpečně na jednom místě a pod ochranou nejdůvěryhodnější značky v oblasti soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkert ét sted og beskyttet af det mest betroede navn inden for privatlivsbeskyttelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicher an einem Ort und geschützt durch den vertrauenswürdigsten Namen in Sachen Datenschutz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ασφαλής σε ένα μέρος και προστατευόμενοι από το πιο αξιόπιστο όνομα στο απόρρητο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Securely in one place and protected by the most trusted name in privacy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma segura en un solo lugar y protegido por el nombre más confiable en privacidad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma segura en un solo lugar y protegido por el nombre más confiable en privacidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turvallisesti samassa paikassa yksityisyyden luotetuimman nimen suojaamina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En toute sécurité, en un seul endroit et protégé par l'entreprise la plus fiable en matière de confidentialité."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztonságosan, egy helyen, és a legmegbízhatóbb adatvédelmi név által védve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersimpan aman di satu tempat dan terlindung oleh nama yang paling terpercaya di ranah privasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al sicuro in un unico posto e protetto dal nome più attendibile nella privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全な場所で、プライバシー保護で最も信頼されている企業によって保護されています。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ერთ ადგილას. დაცული ყველაზე სანდო სახელის მიერ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 안전하게 보관하고 가장 신뢰할 수 있는 개인정보 보호업체의 보호를 받게됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trygt på ett sted og beskyttet av det mest betrodde navnet innen personvern."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veilig op één plek en beschermd door het bedrijf gekend als meest vertrouwde naam op gebied van privacy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpieczne w jednym miejscu i chronione przez najbardziej zaufaną markę w dziedzinie prywatności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com segurança num só lugar e protegido pelo nome mais fiável em privacidade."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com segurança em um só lugar e protegido pelo nome mais confiável em privacidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În siguranță într-un singur loc și protejat de cel mai de încredere nume pentru confidențialitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надежно хранятся в одном месте и защищены самым надежным именем в области конфиденциальности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpečne na jednom mieste a chránené najdôveryhodnejšou značkou v oblasti súkromia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
