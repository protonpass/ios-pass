        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg problemfrit efter elementer via din startskærm. Åbn Indstillinger → Spotlight for at aktivere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahtlos deinen Homescreen nach Elementen durchsuchen. Öffne die Einstellungen → Spotlight aktivieren."
