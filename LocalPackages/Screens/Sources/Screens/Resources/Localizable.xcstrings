    "Seamlessly search for items via your home screen. Open Settings → Spotlight to enable." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкі пошук для элементаў праз ваш дамашні экран. Адкрыйце Налады → Spotlight для ўключэння."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerqueu elements fàcilment a través de la pantalla d'inici. Obriu Configuració → Spotlight per activar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktické vyhledávání pložek pomocí vaší domovské obrazovky. Pro povolení otevřete Nastavení → Centrum pozornosti."
