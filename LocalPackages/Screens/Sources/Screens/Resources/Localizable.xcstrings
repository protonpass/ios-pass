        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητήστε απρόσκοπτα στοιχεία μέσω της αρχικής οθόνης σας. Ανοίξτε τις Ρυθμίσεις → Spotlight για ενεργοποίηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seamlessly search for items via your home screen. Open Settings → Spotlight to enable."
