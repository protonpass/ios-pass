    "No text could be detected in the image. Please try again, ensuring the text is clear, well-lit, and within the camera's focus." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тэкст на відарысе не выяўлены. Пераканайцеся, што тэкст добра чытаецца, хапае асвятлення і відарыс знаходзіцца ў фокусе камеры."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut detectar cap text a la imatge. Torneu-ho a provar, assegurant-vos que el text estigui clar, ben il·luminat i dins de l'enfocament de la càmera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na snímku se nepodařilo rozpoznat žádný text. Zkuste to znovu a ujistěte se, že je text zřetelný, dobře osvětlený a zaostřený."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kunne ikke registreres nogen tekst på billedet. Prøv igen, og sørg for, at teksten er tydelig, godt oplyst og inden for kameraets fokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte kein Text auf dem Bild erkannt werden. Bitte versuche es erneut und stelle sicher, dass der Text klar, gut beleuchtet und im Fokus der Kamera ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατός ο εντοπισμός κειμένου στην εικόνα. Παρακαλούμε δοκιμάστε ξανά, διασφαλίζοντας ότι το κείμενο είναι καθαρό, καλά φωτισμένο και εντός της εστίασης της κάμερας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No text could be detected in the image. Please try again, ensuring the text is clear, well-lit, and within the camera's focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido detectar ningún texto en la imagen. Inténtalo de nuevo, asegurándote de que el texto esté claro, bien iluminado y dentro del enfoque de la cámara."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo detectar ningún texto en la imagen. Inténtelo de nuevo, asegurándose de que el texto esté claro, bien iluminado y dentro del enfoque de la cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvassa ei havaittu tekstiä. Yritä uudelleen ja varmista, että teksti on selkeää, hyvin valaistua ja kamera on tarkentunut siihen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun texte n'a pu être détecté dans l'image. Veuillez réessayer en vous assurant que le texte est clair, bien éclairé et dans la zone de mise au point de l'appareil photo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képen nem lehetett szöveget találni. Próbálja meg újra, hogy a szöveg világos, jól megvilágított és a kamera fókuszában legyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada teks yang dapat dideteksi pada gambar. Silakan coba lagi dengan memastikan bahwa teks ini terlihat jelas, terang, dan berada dalam fokus kamera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato rilevato alcun testo nell'immagine. Riprova, assicurandoti che il testo sia chiaro, ben illuminato e messo a fuoco dalla fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像内にテキストが検出されませんでした。テキストが鮮明で明るく、カメラのフォーカス内であることを確認し、再度お試しください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამოსახულებაში ტექსტი აღმოჩენილი არაა. თავიდან სცადეთ და დარწმუნდით, რომ ტექსტი მკაფიოა, კარგი განათებით და კამერის ფოკუსშია."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지 속에서 감지된 텍스트가 없습니다. 텍스트가 선명하고, 카메라가 초점이 맞춰진 상태에서 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tekst kunne oppdages i bildet. Prøv igjen, og sørg for at teksten er klar, godt opplyst og innenfor kameraets fokus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kon geen tekst worden gevonden in de afbeelding. Probeer het nog een keer ervoor zorgend dat de tekst duidelijk en goed is en binnen de focus van de camera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można wykryć tekstu. Spróbuj ponownie. Upewnij się, że tekst jest wyraźny i dobrze oświetlony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum texto foi detetado na imagem. Tente novamente, garantindo que o texto esteja claro, bem iluminado e em foco na câmara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum texto pôde ser detectado na imagem. Tente novamente, garantindo que o texto esteja claro, bem iluminado e dentro do foco da câmera."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu a putut fi detectat niciun text în imagine. Mai încercați, asigurându-vă că textul este clar, bine iluminat și în focalizarea camerei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось обнаружить текст на изображении. Повторите попытку, убедившись, что текст четкий, хорошо освещен и находится в фокусе камеры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na obrázku nebolo možné rozpoznať žiadny text. Skúste to prosím znova a uistite sa, že je text jasný, dobre osvetlený a v rámci zaostrenia fotoaparátu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V sliki ni bilo mogoče zaznati besedila. Poskusite znova in se prepričajte, da je besedilo jasno, dobro osvetljeno in v fokusu kamere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen text kunde upptäckas i bilden. Försök igen och se till att bilden är tydlig, välbelyst och i kamerans fokus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görselde metin algılanamadı. Lütfen metnin net, iyi aydınlatılmış ve kameranın odak noktasında olduğundan emin olarak yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не виявлено жодного тексту у зображенні. Будь ласка, спробуйте ще раз, переконайтеся в тому, що текст чіткий, добре зрозумілий та знаходиться на зображенні камери."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像中检测不到文本。请再试一次，确保文本清晰、光线充足并在相机对焦范围内。"
          }
        },
        "zh-Hant" : {
