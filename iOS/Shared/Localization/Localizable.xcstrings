            "value" : "Điều này sẽ xóa vĩnh viễn két sắt « %@ » và tất cả nội dung có bên trong. Nhập tên của két sắt để xác nhận việc xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除保险库 « %@ » 及其所有内容。输入保险库名称以确认删除。"
          }
