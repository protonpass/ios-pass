          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perderai l'accesso a questo elemento e ai suoi dettagli. Vuoi continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアイテムへのアクセスとその詳細を失います。続けますか"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაკარგავთ წვდომას ამ ელემენტთან და მის დეტალებთან. გნებავთ გააგრძელოთ"
