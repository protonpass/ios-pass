    "Vaults can’t contain more than 3 users with a free plan." : {
      "comment" : "Message shown to free user to explain the sharing limits in an alert",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховішчы не могуць змяшчаць больш за 3 карыстальнікі з бясплатным тарыфным планам."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les caixes fortes no poden contenir més de 3 usuaris amb un pla gratuït."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trezory nemohou obsahovat více než 3 uživatele s bezplatným tarifem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bokse kan ikke indeholde mere end 3 brugere med et gratis abonnement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tresore können nicht mehr als 3 Benutzer mit einem kostenlosen Abonnement enthalten."
