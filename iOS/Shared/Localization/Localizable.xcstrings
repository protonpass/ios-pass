    "Weak passwords are easier to guess. Generate strong passwords to keep your accounts safe." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ненадзейныя паролі лёгка падабраць. Згенерыруйце надзейны пароль, каб абараніць свой уліковы запіс."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contrasenyes febles són més fàcils d'endevinar. Genereu contrasenyes robustes per a mantenir el compte segur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slabá hesla lze snáze uhodnout. Vygenerujte si silná hesla, aby byly vaše účty v bezpečí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svage adgangskoder er lettere at gætte. Opret stærke adgangskoder for at holde dine konti sikre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwache Passwörter sind leichter zu erraten. Erstelle sichere Passwörter, um deine Konten zu schützen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αδύναμοι κωδικοί πρόσβασης είναι πιο εύκολο να μαντέψουν. Δημιουργήστε ισχυρούς κωδικούς πρόσβασης για να διατηρήσετε τους λογαριασμούς σας ασφαλείς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weak passwords are easier to guess. Generate strong passwords to keep your accounts safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas débiles son fáciles de adivinar. Genera contraseñas seguras para mantener tus cuentas seguras."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas débiles son fáciles de adivinar. Genere contraseñas seguras para mantener las cuentas seguras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heikot salasanat ovat helpommin arvattavissa. Suojaa tilisi luomalla niille vahvat salasanat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe faibles sont plus faciles à deviner. Générez des mots de passe forts pour assurer la sécurité de vos comptes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyenge jelszavakat könnyeben ki lehet találni. Hozzon létre erős jelszavakat, a fiókjai biztonsága érdekében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi yang lemah akan lebih mudah untuk ditebak. Hasilkan kata sandi yang kuat untuk menjaga akun Anda tetap aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le password deboli sono più facili da indovinare. Genera password complesse per mantenere i tuoi account al sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弱いパスワードは推測されやすく、安全ではありません。アカウントを安全に保つために強力なパスワードを生成してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სუსტი პაროლების მიხვედრა ადვილია. შექმენით ძლიერი პაროლები, რომ თქვენი ანგარიში უსაფრთხოდ იყოს."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약한 비밀번호는 추측하기 쉽습니다. 계정을 안전하게 보호하기 위해 강한 비밀번호를 생성하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svake passord er lettere å gjette. Generer sterke passord for å holde kontoene dine trygge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwakke wachtwoorden zijn makkelijker te raden. Genereer sterke wachtwoorden om uw accounts veilig te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słabe hasła są łatwiejsze do odgadnięcia. Wygeneruj silne hasła, aby zapewnić bezpieczeństwo swoim kontom."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palavras-passe fracas são mais fáceis de adivinhar. Gere palavras-passe fortes para manter as suas contas seguras."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senhas fracas são mais fáceis de adivinhar. Gere senhas fortes para manter suas contas seguras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolele slabe sunt ușor de ghicit. Generați parole puternice pentru a vă păstra conturile în siguranță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простые пароли легче угадать. Создавайте сложные пароли, чтобы обезопасить свои аккаунты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slabé heslá sa dajú ľahšie uhádnuť. Vygenerujte si silné heslá, aby boli vaše účty v bezpečí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šibka gesla je lažje uganiti. Ustvarite močna gesla, da bodo vaši računi varni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaga lösenord är lättare att gissa. Generera starka lösenord för att hålla dina konton säkra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zayıf parolaların öngörülmesi daha kolaydır. Hesaplarınızı güvende tutmak için güçlü parolalar oluşturun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слабкі паролі легше вгадати. Створюйте надійні паролі, щоб захистити свої облікові записи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu yếu rất dễ bị suy đoán. Khởi tạo mật khẩu mạnh để giữ an toàn các tài khoản của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弱密码更容易被猜中。生成强大的密码，确保账户安全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弱密碼字元更容易猜到。產生強度高的密碼字元，以確保您的帳號安全。"
          }
        }
      }
    },
