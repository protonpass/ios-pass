          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan diminta untuk memasukkan kata sandi ini pada saat masuk dan pada saat berpindah dari aplikasi Proton lain ke Proton Pass melalui situs web."
