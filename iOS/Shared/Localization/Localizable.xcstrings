          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will lose access to this item and its details. Do you want to continue"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perderás el acceso a este artículo y a sus detalles. ¿Deseas continuar?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
