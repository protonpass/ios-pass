    "When moving items between vaults we will preserve up to the last 50 modifications performed to each item" : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі элементы перамяшчаюцца паміж сховішчамі, то сістэма захавае да 50 змяненняў, якія выкананы для кожнага элемента"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En moure elements entre caixes fortes, conservarem fins a les últimes 50 modificacions realitzades a cada element"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při přesouvání položek mezi trezory uchováme až 50 posledních úprav provedených na každé položce"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når vi flytter elementer mellem bokse, bevarer vi op til de sidste 50 ændringer, der er foretaget på hvert element."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verschieben von Einträgen zwischen Tresoren bewahren wir bis zu 50 der letzten Änderungen an jedes Eintrags auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατά τη μετακίνηση αντικειμένων μεταξύ κρυπτών, θα διατηρήσουμε έως και τις τελευταίες 50 τροποποιήσεις που πραγματοποιήθηκαν σε κάθε αντικείμενο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When moving items between vaults we will preserve up to the last 50 modifications performed to each item"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al mover elementos entre cajas fuertes conservaremos hasta las últimas 50 modificaciones realizadas de cada elemento."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al mover elementos entre bóvedas conservaremos hasta las últimas 50 modificaciones realizadas de cada elemento"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kohteita siirretään holvien välillä, säilytetään enintään 50 viimeisintä kuhunkin kohteeseen tehtyä muokkausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand des éléments sont déplacés d'un coffre-fort à l'autre, nous conservons jusqu'aux 50 dernières modifications apportées à chaque élément."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elemek tárolók közti mozgatásakor minden elem legutóbbi maximum 50 módosítása marad meg"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada saat memindahkan item antar brankas, kami akan menyimpan hingga 50 perubahan terakhir yang diberlakukan kepada masing-masing item"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostando gli elementi tra le casseforti, conserveremo fino alle ultime 50 modifiche apportate a ciascun elemento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫間でアイテムを移動する場合、各アイテムの直近50回以内の変更のみ保持します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სათავსოებს შორის ნივთების გადაადგილებისას ჩვენ შევინარჩუნებთ თითოეულ ნივთზე შესრულებულ ბოლო 50 მოდიფიკაციას"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금고 사이로 항목을 이동할 때 각 항목에 대해 이동된 마지막 50개의 수정 사항이 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du flytter elementer mellom hvelv, vil vi bevare opptil de siste 50 modifikasjonene som er utført på hvert element."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het verplaatsen van items tussen kluizen bewaren we tot de laatste 50 wijzigingen uitgevoerd op elk item"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas przenoszenia elementów między sejfami zachowamy historię do 50 ostatnich modyfikacji elementów"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao mover itens entre cofres, manteremos até as últimas 50 modificações realizadas em cada item."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando movendo itens entre cofres, nós preservaremos as últimas 50 modificações feitas em cada item."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mutarea articolelor între seifuri, vom păstra până la ultimele 50 de modificări efectuate fiecărui articol."
          }
        },
        "ru" : {
          "stringUnit" : {
