    "Resetting history will permanently delete all past versions and cannot be undone." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скіданне гісторыі прывядзе да незваротнага выдалення ўсіх мінулых версій і гэту аперацыю немагчыма будзе адрабіць."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
