        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuz kapatılacak ve diğer tüm aygıtlarınızda yeniden oturum açmanız gerekecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви вийдете із системи, і вам доведеться увійти знову на всіх інших пристроях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ bị đăng xuất và phải đăng nhập lại trên các thiết bị khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您将被注销并需要在所有其他设备上重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您將被登出，且所有已登入的裝置皆需重新登入"
          }
        }
      }
    },
    "You will lose access to this item and its details. Do you want to continue?" : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы згубіце доступ да гэтага элемента і яго падрабязнасцяў. Вы сапраўды хочаце працягнуць?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdéreu l'accés a aquest element i als seus detalls. Voleu continuar?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztratíte přístup k této položce a jejím detailům. Chcete pokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil miste adgang til dette element og dets detaljer. Ønsker du at fortsætte"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst den Zugriff auf dieses Element und seine Details verlieren. Möchtest du fortfahren"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
