    "Every time your alias receives an email from someone, a new contact is automatically created." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новы кантакт ствараецца аўтаматычна. Гэта адбываецца кожны раз, калі ваш псеўданім атрымлівае ліст ад каго-небудзь."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vegada que el vostre alias rep un correu electrònic de algú, es crea automàticament un contacte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaždé, když váš alias od někoho obdrží e-mail, automaticky se vytvoří nový kontakt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang dit alias modtager en e-mail fra nogen, oprettes der automatisk en ny kontakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Mal, wenn dein Alias eine E-Mail von einer Person erhält, wird automatisch ein neuer Kontakt erstellt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε φορά που το ψευδώνυμό σας λαμβάνει ένα μήνυμα ηλεκτρονικού ταχυδρομείου από κάποιον, μια νέα επαφή δημιουργείται αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time your alias receives an email from someone, a new contact is automatically created."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que tu alias reciba un correo de alguien, se creará automáticamente un contacto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que su alias reciba un correo de alguien, se creará automáticamente un contacto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aina kun aliaksesi vastaanottaa viestin, uusi yhteystieto luodaan automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fois que votre alias reçoit un email de quelqu’un, un nouveau contact est automatiquement créé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden alkalommal, amikor az e-mail álneve üzenetet kap valakitől, automatikusan létrejön egy új névjegy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
