          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнаружено изменение в ваших настройках биометрической аутентификации. В целях безопасности вас вывели из системы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zistili sme zmenu vo vašich nastaveniach biometrického overovania. Z bezpečnostných dôvodov došlo k odhláseniu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har upptäckt en förändring i dina biometriska autentiseringsinställningar. Av säkerhetsskäl har du blivit utloggad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biyometrik kimlik doğrulama ayarlarınızda değişiklik yapıldığı algılandı. Güvenlik nedeniyle oturumunuz kapatıldı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми виявили зміни у ваших налаштуваннях біометричної автентифікації. З міркувань безпеки ви вийшли з системи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们检测到您的生物识别身份验证设置发生了更改。出于安全原因，您已被注销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們偵測到您的生物識別驗證設定值有變更。基於安全考量，您已登出。"
