          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendszer kijelentkezteti, és az összes többi eszközén újra be kell jelentkeznie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan dikeluarkan dari akun dan perlu untuk masuk kembali pada seluruh perangkat lainnya yang Anda miliki"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrai disconnesso e dovrai accedere nuovamente su tutti gli altri tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログアウトされ、全ての他のデバイスで再度ログインが必要になります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენ ახლა გახვალთ და უნდა თავიდან შემოსვლა მოგიწევთ ყველა თქვენი სხვა მოწყობილობიდან."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 로그아웃되고 다른 모든 장치에서 다시 로그인해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blir logget ut og må logge på igjen på alle de andre enhetene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U wordt uitgelogd en moet opnieuw inloggen op al uw andere apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konieczne będzie ponowne zalogowanie się na wszystkich urządzeniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Será desconectado e terá de iniciar sessão novamente em todos os seus outros dispositivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
