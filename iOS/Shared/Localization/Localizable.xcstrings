    "We have detected a change in your biometric authentication settings. For security reasons, you have been logged out." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сістэма выявіла, што ў вашых наладах аўтэнтыфікацыі па біяметрыі адбыліся змяненні. У мэтах бяспекі вам неабходна паўторна ўвайсці ў сістэму."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hem detectat un canvi en la vostra configuració d'autenticació biomètrica. Per motius de seguretat, heu tancat la sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjistili jsme změnu ve vašem nastavení biometrického ověřování. Z bezpečnostních důvodů jste byli odhlášeni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har opdaget en ændring i dine biometriske godkendelsesindstillinger. Af sikkerhedsårsager er du blevet logget ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben eine Änderung in deinen Einstellungen für die biometrische Authentifizierung festgestellt. Aus Sicherheitsgründen wurdest du abgemeldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εντοπίσαμε μια αλλαγή στις ρυθμίσεις βιομετρικού ελέγχου ταυτότητας. Για λόγους ασφαλείας, έχετε αποσυνδεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have detected a change in your biometric authentication settings. For security reasons, you have been logged out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos detectado un cambio en los ajustes de autenticación biométricos. Por razones de seguridad, se ha cerrado la sesión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos detectado un cambio en los ajustes de autenticación biométricos. Por razones de seguridad, se ha cerrado la sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometrisen tunnistautumisen asetuksissasi on havaittu muutoksia. Turvallisuussyistä sinut on kirjattu ulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons détecté un changement dans vos paramètres d'authentification biométrique. Pour des raisons de sécurité, vous avez été déconnecté."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Változást észleltünk a biometrikus hitelesítési beállításaiban. Biztonsági okokból Önt kijelentkeztettük."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami mendeteksi perubahan dalam pengaturan autentikasi biometrik Anda. Demi alasan keamanan, Anda telah dikeluarkan dari akun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo rilevato una modifica nelle impostazioni di autenticazione biometrica. Per motivi di sicurezza sei stato disconnesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生体認証設定に変更が検出されました。セキュリティ上の理由から、ログアウトされました。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აღმოჩენილია ცვლილებები თქვენი ბიომეტრიული ავთენტიკაციის პარამეტრებში. უსაფრთხოებისთვის, გახვედით სისტემიდან."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생체 인증 설정에 변경사항이 감지되었습니다. 보안상의 이유로 로그아웃 되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har oppdaget en endring i innstillingene for biometrisk autentisering. Av sikkerhetsgrunner har du blitt logget av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben een wijziging gedetecteerd in uw biometrische verificatie-instellingen. Om veiligheidsredenen bent u afgemeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykryliśmy zmianę ustawień uwierzytelniania biometrycznego. Wylogowano ze względów bezpieczeństwa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detetámos uma alteração nas suas definições de autenticação biométrica. Por questões de segurança, foi desconectado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectamos mudanças nas suas configurações de autenticação biométrica. Por motivos de segurança a sua sessão foi encerrada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
