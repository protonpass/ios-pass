    "This will permanently delete the vault « %@ » and all its contents. Enter the vault name to confirm deletion." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэта дзеянне прывядзе да выдалення сховішча з назвай « %@ » і ўсяго яго змесціва. Увядзіце назву сховішча, каб пацвердзіць выдаленне."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això suprimirà permanentment la caixa forta \"%@\" i tot el seu contingut. Introduïu el nom de la caixa forta per confirmar-ne l'eliminació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto trvale smaže trezor « %@ » a veškerý jeho obsah. Zadejte název trezoru pro potvrzení smazání."
