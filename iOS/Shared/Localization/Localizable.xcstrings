    "You will be asked for this password during login and when switching from another Proton app to Proton Pass on web." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас будуць пытацца гэты пароль падчас уваходу і пры пераключэнні з іншай праграмы Proton на Proton Pass для браўзера."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se us demanarà aquesta contrasenya durant la sessió i quan canvieu d'una altra aplicació Proton a Proton Pass al web."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toto heslo budete požádáni při přihlašování a při přechodu z jiné aplikace Proton do Proton Pass na webu."
