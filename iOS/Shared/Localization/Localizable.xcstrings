    "At least one of the selected items is currently shared. Moving it to another vault will remove access for all other users." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прынамсі адзін з выбраных элементаў у цяперашні час абагулены. Яго перамяшчэнне ў іншае сховішча пазбавіць доступу ўсіх іншых карыстальнікаў."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almenys un dels elements seleccionats està compartit actualment. Si el mou a una altra volta, se suprimirà l'accés a la resta d'usuaris."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alespoň jedna z vybraných položek je aktuálně sdílena. Přesunutím do jiného trezoru se zruší přístup pro všechny ostatní uživatele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindst et af de valgte elementer er i øjeblikket delt. Hvis du flytter det til en anden boks, fjerner du adgangen for alle andre brugere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens eines der ausgewählten Einträge ist derzeit geteilt. Wenn du es in einen anderen Tresor verschiebst, wird der Zugriff für alle anderen Benutzer entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τουλάχιστον ένα από τα επιλεγμένα στοιχεία είναι κοινόχρηστο αυτήν τη στιγμή. Η μετακίνησή του σε άλλη κρύπτη θα καταργήσει την πρόσβαση για όλους τους άλλους χρήστες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least one of the selected items is currently shared. Moving it to another vault will remove access for all other users."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos uno de los elementos seleccionados está compartido actualmente. Si lo mueves a otra caja fuerte, se eliminará el acceso para todos los demás usuarios."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos uno de los elementos seleccionados está compartido actualmente. Si lo mueve a otra bóveda, se eliminará el acceso para todos los demás usuarios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainakin yksi valituista kohteista on jaettu tällä hetkellä. Sen siirtäminen toiseen holviin poistaa pääsyn muilta käyttäjiltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins un des éléments sélectionnés est actuellement partagé. Son déplacement vers un autre coffre-fort retirera également son accès aux autres utilisateurs."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott elemek közül legalább egy jelenleg meg van osztva. Ha áthelyezi egy másik tárolóba, az összes többi felhasználó számára megszűnik a hozzáférés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setidaknya salah satu item yang dipilih saat ini sedang dibagikan. Memindahkan item ini ke brankas lain akan menghilangkan izin akses bagi seluruh pengguna lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno uno degli elementi selezionati è attualmente condiviso. Lo spostamento in un altro deposito rimuoverà l'accesso per tutti gli altri utenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したアイテムの少なくとも1つが共有されています。他の保管庫に移動すると、他のすべてのユーザーのアクセスが削除されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მონიშნული ელემენტებიდან ერთი მაინც გაზიარებულია. მისი სხვა საცავში გადატანა ყველა სხვა მომხმარებელს მასწზე წვდომას დაუკარგავს."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최소 하나의 선택된 항목이 현재 공유 중입니다. 다른 사용자의 접근 권한이 상실됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minst ett av de valgte elementene er for øyeblikket delt. Hvis du flytter det til et annet hvelv, fjernes tilgangen for alle andre brukere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minstens één van de geselecteerde items wordt momenteel gedeeld. Als u het naar een andere kluis verplaatst, wordt de toegang voor alle andere gebruikers verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co najmniej jeden zaznaczony element jest udostępniony. Przeniesienie go do innego sejfu spowoduje zatrzymanie udostępniania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo menos um dos itens selecionados é atualmente partilhado. Movê-lo para outro cofre removerá o acesso de todos os outros utilizadores."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo menos um dos itens selecionados está atualmente compartilhado. Movê-lo para outro cofre removerá o acesso de todos os outros usuários."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel puțin unul dintre articolele selectate este partajat deja. Mutarea acestuia în alt seif va elimina accesul pentru toți ceilalți utilizatori."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По крайней мере один из выбранных элементов в настоящее время является общей. Его перемещение в другое хранилище закроет доступ для всех остальных пользователей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspoň jedna z vybraných položiek je aktuálne zdieľaná. Jej presunutím do iného trezora sa zruší prístup pre všetkých ostatných používateľov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minst ett av de valda objekten delas för närvarande. Att flytta det till annat valv kommer ta bort åtkomst för alla andra användare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilmiş ögelerden en az biri şu anda paylaşılıyor. Başka bir kasaya taşırsanız diğer kullanıcıların erişimi kaldırılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принаймні один з вибраних елементів наразі знаходиться у спільному доступі. Переміщення його до іншого сховища вилучить доступ для всіх інших користувачів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ít nhất một trong các mục đã chọn hiện đang được chia sẻ. Nếu di chuyển sang két sắt khác, tất cả người dùng hiện có sẽ mất quyền truy cập vào mục này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选项目中至少有一个目前是共享的。将其移至另一个保险库将会取消所有其他用户的访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已選取的項目當中有共享中的項目。移至另一個保管庫的同時，將移除所有分享給其他使用者的存取權限。"
          }
        }
      }
    },
