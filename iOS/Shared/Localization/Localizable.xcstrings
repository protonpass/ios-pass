    },
    "You will be logged out and will have to log in again on all of your other devices." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На ўсіх вашых іншых прыладах сеанс будзе завершаны і вам неабходна будзе аўтарызавацца паўторна."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se us tancarà la sessió i haureu de tornar a iniciar-la en tots els altres dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budete odhlášeni a budete se muset znovu přihlásit na všech svých ostatních zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bliver logget ud og skal logge ind igen på alle dine andre enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst abgemeldet und musst dich auf allen anderen Geräten erneut anmelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα αποσυνδεθείτε και θα πρέπει να συνδεθείτε ξανά σε όλες τις άλλες συσκευές σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will be logged out and will have to log in again on all of your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará la sesión y tendrás que volver a iniciarla en todos los dispositivos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará la sesión y tendrá que volver a iniciarla en todos los dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinut kirjataan ulos ja joudut kirjautumaan uudelleen sisään kaikilla muilla laitteillasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
