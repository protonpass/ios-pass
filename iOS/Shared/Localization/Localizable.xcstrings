    "Aliases in Trash will continue forwarding emails. If you want to stop receiving emails on this address, disable it instead." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псеўданімы перамешчаныя ў Сметніцу працягнуць перасылаць лісты. Спачатку адключыце псеўданім, калі хочаце спыніць атрыманне лістоў на гэты адрас."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els àlies a la paperera continuaran reenviant correus electrònics. Si voleu deixar de rebre correus electrònics en aquesta adreça, desactiveu-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasy v koši budou nadále přeposílat e-maily. Pokud chcete přestat dostávat e-maily na tuto adresu, deaktivujte ji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasser i papirkurven vil fortsat videresende mails. Hvis du vil stoppe med at modtage mails på denne adresse, bedes du deaktivere den i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliase im Papierkorb werden weiterhin E-Mails weiterleiten. Wenn du keine E-Mails mehr an diese Adresse erhalten willst, deaktiviere es stattdessen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ψευδώνυμα στον Κάδο Απορριμάτων θα συνεχίσουν να προωθούν μηνύματα ηλεκτρονικού ταχυδρομείου. Εάν θέλετε να σταματήσετε να λαμβάνετε μηνύματα ηλεκτρονικού ταχυδρομείου σε αυτήν τη διεύθυνση, απενεργοποιήστε την."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliases in Trash will continue forwarding emails. If you want to stop receiving emails on this address, disable it instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los alias que se encuentren en la Papelera seguirán reenviando correos electrónicos. Deshabilita la dirección si deseas dejar de recibirlos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los alias en la papelera continuarán reenviando correos. Si desea dejar de recibir correos en esta dirección, desactívela en su lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roskakorissa olevat aliakset ohjaavat viestejä edelleen. Lopeta viestien vastaanottaminen tällä osoitteella poistamalla alias käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alias dans la corbeille continueront à transférer les e-mails. Si vous souhaitez arrêter de recevoir des e-mails à cette adresse, désactivez-la à la place."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lomtárban lévő e-mail álnevek továbbra is továbbítják az e-maileket. Ha nem szeretne e-maileket kapni azon a álneven, inkább tiltsa le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias dalam Sampah akan masih meneruskan email. Jika Anda ingin berhenti menerima email pada alamat ini, nonaktifkan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli alias nel Cestino continueranno a inoltrare le email. Se non vuoi più ricevere email su questo indirizzo, disabilitalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱にあるエイリアスは引き続きメールが転送されます。このアドレスからのメールを受け取りたくない場合は、代わりに無効にしてください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნაგვის ყუთში მოთავსებული ფსევდონიმები ელფოსტის გადაგზავნას გააგრძელებენ. თუ გნებავთ, შეწყვიტოთ ამ მისამართზე ელფოსტის მიღება, გათიშეთ ის."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통 내 별칭이 계속 이메일 가져오기를 진행합니다. 이 주소에 대한 수신을 중단하려면 별칭을 비활성화하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliaser i papirkurven fortsetter å videresende e-poster. Hvis du vil slutte å motta e-post på denne adressen, deaktiver det i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliassen in de prullenbak worden doorgestuurd naar e-mails. Als u wilt stoppen met het ontvangen van e-mails op dit adres, schakel dit in plaats daarvan uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasy w koszu będą nadal przekierowywać wiadomości. Wyłącz alias, jeśli chcesz zatrzymać otrzymywanie wiadomości na ten adres."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os aliases no lixo continuarão a encaminhar e-mails. Se quiser parar de receber e-mails neste endereço, desative-o em vez disso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os endereços alternativos na Lixeira continuarão encaminhando e-mails. Se você quiser parar de receber e-mails nesse endereço, desative-o."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasurile din gunoi vor continua să redirecționeze mesajele primite. Dacă doriți să nu mai primiți mesaje la această adresă, dezactivați-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псевдонимы в Корзине будут продолжать пересылать сообщения. Если вы хотите прекратить получение писем на этот адрес, отключите его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasy v koši budú aj naďalej preposielať emaily. Ak chcete prestať dostávať emaily na túto adresu, vypnite ju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias ​​i papperskorg fortsätter att vidarebefordra e-post. Om du vill sluta ta emot e-post på denna adress, inaktivera den istället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp kutusundaki takma adlar e-postaları iletmeyi sürdürür. Bu adreslere e-posta almayı durdurmak istiyorsanız, çöpe atmak yerine kullanımdan kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псевдоніми у «Смітнику» продовжуватимуть пересилати листи. Якщо ви хочете припинити отримувати їх на цю адресу, вимкніть псевдонім."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bí danh trong Thùng rác sẽ tiếp tục chuyển tiếp email. Nếu bạn muốn ngừng nhận\nemail tại địa chỉ này, thay vào đó hãy vô hiệu hóa nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除邮件中的别名将继续转发电子邮件。如果您想停止在此地址接收电子邮件，请将其禁用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垃圾桶中的別名仍會持續轉寄電子郵件。若您不希望接收此來自此別名位址的電子郵件，請改為停用。"
          }
        }
      }
    },
    "Aliases with custom domains are not monitored, please add them as a custom email for monitoring." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псеўданімы з карыстальніцкіх даменаў не адсочваюцца. Дадайце іх як карыстальніцкія адрасы электроннай пошты для назірання."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els àlies amb dominis personalitzats no se supervisen; afegiu-los com a correu electrònic personalitzat per al seguiment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasy s vlastními doménami nejsou sledovány, přidejte je prosím jako vlastní e-mail pro sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasser med brugerdefinerede domæner monitoreres ikke, tilføj dem som en brugerdefineret e-mail til monitorering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasse mit eigenen Domains werden nicht überwacht. Bitte füge diese als eigene E-Mail-Adresse hinzu, um sie zu überwachen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ψευδώνυμα με προσαρμοσμένους τομείς δεν παρακολουθούνται, προσθέστε τα ως προσαρμοσμένο email για παρακολούθηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliases with custom domains are not monitored, please add them as a custom email for monitoring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los alias con dominios personalizados no son monitoreados. Añádelos como correo electrónico personalizado para monitorearlos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los alias con dominios personalizados no son monitoreados. Añádalos como correo electrónico personalizado para monitorearlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omia verkkotunnuksiasi käyttäviä aliaksia ei valvota. Lisää ne valvontaan ulkoisina sähköpostiosoitteina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alias avec des domaines personnalisés ne sont pas surveillés. Ajoutez-les comme e-mails personnalisés pour la surveillance."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az saját domain névvel létrehozott álnevek nincsenek figyelve, ezeket egyéni e-mail figyelésként adhatja hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias dengan domain khusus tidak dipantau. Silakan tambahkan alias ini sebagai surel khusus untuk keperluan pemantauan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli alias con domini personalizzati non vengono monitorati, aggiungili come email personalizzata per il monitoraggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタム ドメインを持つエイリアスは監視されません。監視用のカスタムメールとして追加してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მორგებული დომენების მქონე ფსევდონიმების მონიტორინგი არ ხდება. მათი მონიტორინგისთვის ისინი მორგებული ელფოსტის სახით დაამატეთ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커스텀 도메인을 사용한 별칭은 모니터링 대상이 아니므로, 커스텀 이메일로 모니터링에 추가해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliaser med egendefinerte domener overvåkes ikke, legg dem til som en tilpasset e-post for overvåking."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliassen met persoonlijke domeinen worden niet gemonitord, voeg ze toe als een persoonlijke e-mail voor controle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasy z niestandardowymi domenami nie są monitorowane. Dodaj je jako niestandardowy adres e-mail do monitorowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os aliases com domínios personalizados não são monitorados. Adicione-os como um e-mail personalizado para poderem ser monitorizados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endereços alternativos com domínios personalizados não são monitorados, adicione-os como um e-mail personalizado para monitoramento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasurile cu domenii personale nu sunt monitorizate. Adăugați-le ca e-mail personal pentru monitorizare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псевдонимы с пользовательскими доменами не отслеживаются, пожалуйста, добавьте их в качестве пользовательского электронного адреса для мониторинга."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasy s vlastnými doménami nie sú monitorované, pridajte ich do monitorovania ako vlastný email."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzdevki z domenami po meri se ne spremljajo, dodajte jih kot e-poštni naslov po meri za spremljanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias med anpassade domäner övervakas inte, lägg till dem som en anpassad e-post för övervakning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel etki alanlarındaki takma adlar izlenmez. Lütfen bunları izlemek için bir özel e-posta olarak ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псевдоніми з власними доменами не відстежуються, будь ласка, додайте їх як власну пошту для моніторингу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bí danh cho tên miền tùy chọn không được theo dõi, hãy thêm vào danh sách email tùy chọn để có thể theo dõi chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "具有自定义域的别名不受监控，请将其添加为自定义电子邮件进行监控。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自訂網域的別名不會受到監控，請將它們新增為自訂電子郵件以利監控。"
          }
        }
      }
    },
