    "Enable monitoring to get notified if your aliases were leaked." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уключыце назіранне для таго, каб быць у курсе выяўлення ўцечкі вашых псеўданімаў."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habiliteu el monitoratge per rebre una notificació si es filtren els vostres àlies."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte sledování, abyste byli informováni, pokud došlo k úniku vašich aliasů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivér monitorering for at få besked, hvis dine aliasser bliver lækket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die Überwachung, um benachrichtigt zu werden, wenn deine Aliasse bei einem Datenleck aufgetaucht sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε την παρακολούθηση για να ειδοποιηθείτε εάν τα ψευδώνυμά σας διέρρευσαν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable monitoring to get notified if your aliases were leaked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el monitoreo para recibir notificaciones si los alias fueron filtrados."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active el monitoreo para recibir notificaciones si los alias fueron filtrados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä valvontaa saadaksesi ilmoituksen, jos aliaksiasi on vuotanut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la surveillance pour savoir si vos alias ont été divulgués."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be a megfigyelést, hogy értesítést kapjon, ha az álnevei kiszivárogtak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan pemantauan untuk memperoleh notifikasi apabila alias Anda dibocorkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita il monitoraggio per ricevere una notifica qualora i tuoi alias vengano resi pubblici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エイリアスが漏洩した場合に通知を受け取るには、監視を有効にします。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჩართეთ მონიტორინგი, თუ გნებავთ, მიიღოთ გაფრთხლება, თუ თქვენი ფსევდონიმები გაჟონავს."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별칭이 유출되었을 때 알림을 받으려면 모니터링을 활성화하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver overvåking for å bli varslet hvis aliasene dine ble lekket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel monitoring in om een melding te krijgen als uw aliassen zijn gelekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz monitoring, aby otrzymać powiadomienie o ujawnieniu aliasów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a monitorização para ser notificado caso os seus aliases sejam divulgados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o monitoramento para ser notificação se seus aliases se forem vazados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați monitorizarea pentru a primi notificări dacă aliasurile v-au fost divulgate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите мониторинг, чтобы получать уведомления об утечке ваших псевдонимов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
