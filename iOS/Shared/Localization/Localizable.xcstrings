    "Sentinel description" : {
      "comment" : "Description of the sentinel feature.",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel - гэта ўдасканаленая праграма абароны ўліковых запісаў, якая падтрымліваецца складанымі сістэмамі штучнага інтэлекту і спецыялістамі, што працуюць дзень і ноч, каб абараніць вас ад зламыснікаў і пагроз бяспекі."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel és un programa avançat de protecció de comptes impulsat per sistemes d'IA sofisticats i especialistes que treballen durant tot el dia per protegir-vos dels mals actors i les amenaces de seguretat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel je pokročilý program na ochranu účtů založený na sofistikovaných systémech umělé inteligence a specialistech, kteří nepřetržitě pracují na vaší ochraně před útočníky a bezpečnostními hrozbami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel er et avanceret kontobeskyttelsesprogram drevet af sofistikerede AI-systemer og specialister, der arbejder døgnet rundt for at beskytte dig mod ondsindede aktører og sikkerhedstrusler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel ist ein fortschrittliches Kontoschutzprogramm, das von hochentwickelten KI-Systemen und Spezialisten betrieben wird, die rund um die Uhr arbeiten, um dich vor böswilligen Akteuren und Sicherheitsbedrohungen zu schützen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Proton Sentinel είναι ένα προηγμένο πρόγραμμα προστασίας λογαριασμού που λειτουργεί με προηγμένα συστήματα Τεχνητής Νοημοσύνης και οι ειδικοί εργάζονται συνεχώς για να σας προστατεύσουν από κακούς λειτουργούς και από απειλές ασφαλείας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel is an advanced account protection program powered by sophisticated AI systems and specialists working around the clock to protect you from bad actors and security threats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel es un programa avanzado de protección de cuentas impulsado por sistemas sofisticados de inteligencia artificial y especialistas que trabajan las 24 horas para protegerte de malos actores y amenazas de seguridad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel es un programa avanzado de protección de cuentas impulsado por sistemas sofisticados de inteligencia artificial y especialistas que trabajan las 24 horas para protegerle de malos actores y amenazas de seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel on edistynyt moderneja tekoälyjärjestelmiä ja asiantuntijoita hyödyntävä tilin suojausohjelma, joka suojaa sinua vaarallisilta tahoilta ja tietoturvauhkilta ympäri vuorokauden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel est un programme avancé de protection des comptes qui s'appuie sur des systèmes d'IA sophistiqués et des spécialistes qui travaillent en permanence pour vous protéger des acteurs malveillants et des menaces de sécurité."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Proton Sentinel egy komplex MI rendszerekkel vezérelt, fejlett fiókvédelmi program, amely szakemberek folyamatos támogatásával védi a támadóktól és biztonsági fenyegetésekről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel merupakan program perlindungan akun tingkat lanjut yang diberdayakan oleh sistem AI canggih serta para ahli yang bekerja tanpa henti untuk melindungi Anda dari pelaku tindak kejahatan dan ancaman keamanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel è un programma di protezione avanzata degli account, basato su una sofisticata intelligenza artificiale e specialisti pronti a proteggerti dai malintenzionati in rete e da tutte le minacce alla sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel は、洗練された AI システムとスペシャリストを活用した高度なアカウント保護プログラムで、悪者やセキュリティの脅威からユーザーを保護するために 24 時間体制で働いています。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel დამატებითი ანგარიშის დაცვის პროგრამაა, რომელიც რთულ AI სისტემებს ეყრდნობა და გვყავს სპეციალისტები, რომლებიც მუხლჩაუხრელად მუშაობენ, რათა თქვენი უსაფრთხოება არასასურველი პირებისგან დაიცვან."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel은 보안 위협으로부터 사용자를 보호하기 위해 24시간 작동하는 정교한 AI 시스템과 보안계 전문가들로 이루워진 고급 계정 보호 프로그램입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel er et avansert kontobeskyttelsesprogram drevet av sofistikerte AI-systemer og spesialister som jobber døgnet rundt for å beskytte deg mot dårlige aktører og sikkerhetstrusler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel is een geavanceerd accountbeschermingsprogramma aangedreven door geavanceerde AI-systemen en specialisten die over de hele tijd werken om u te beschermen tegen slechte spelers en veiligheidsbedreigingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel to zaawansowany program ochrony konta wspierany przez systemy sztucznej inteligencji i specjalistów pracujących całą dobę, w celu łagodzenia ataków i zagrożeń bezpieczeństwa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel é um programa avançado de proteção de conta, alimentado por sofisticados sistemas de IA e especialistas que trabalham ininterruptamente para o proteger de pessoas mal-intencionadas e ameaças à segurança."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel é um programa avançado de proteção de conta, alimentado por sofisticados sistemas de IA e especialistas, trabalhando ininterruptamente para proteger você de pessoas mal-intencionadas e ameaças à segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel este un program avansat de protecție a conturilor, alimentat de sisteme de IA sofisticate și specialiști care lucrează non-stop pentru a vă proteja de atacatori și amenințările de securitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel это продвинутая программа для защиты аккаунта, которая защищает вас от злоумышленников и угроз безопасности при помощи мощных ИИ и круглосуточно работающих специалистов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel je pokročilý program na ochranu účtov založený na sofistikovaných systémoch AI a špecialistoch pracujúcich nepretržite, aby vás chránili pred útočníkmi a bezpečnostnými hrozbami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel je napreden program za zaščito računa, ki ga poganjajo prefinjeni sistemi umetne inteligence in strokovnjaki, ki delajo 24 ur na dan, da vas zaščitijo pred zlobnimi akterji in varnostnimi grožnjami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel är ett avancerat kontoskyddsprogram som drivs av sofistikerade AI-system och specialister som arbetar dygnet runt för att skydda dig från dåliga aktörer och säkerhetshot."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel, sizi kötü niyetli kişilerden ve güvenlik tehditlerinden korumak için günün her saati çalışan, karmaşık yapay zeka sistemleri ile uzmanlar tarafından desteklenen gelişmiş bir hesap koruma programıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel — це передовий застосунок захисту облікових записів, що працює на основі складних системах ШІ та спеціалістів, які цілодобово захищають вас від зловмисників та загроз безпеці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel là một chương trình bảo vệ tài khoản nâng cao. Hoạt động dựa trên nền tảng các hệ thống trí tuệ nhân tạo phức tạp cùng đội ngũ chuyên gia thường xuyên túc trực để bảo vệ bạn khỏi kẻ xấu và các mối đe dọa đến sự an toàn của tài khoản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel 是一项高级的账户保护程序，由先进的人工智能系统和专家提供支持，全天候保护您免受不良分子和安全威胁的侵害。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Sentinel 是一種高級帳號保護程序，由最新的 AI 系統和全天候工作的專家提供協助，以保護您免受不良行為者與安全威脅的侵害。"
          }
        }
      }
    },
