    "To interact with your other vaults, you need to upgrade your account." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Палепшыце падпіску свайго ўліковага запісу, каб мець магчымасць узаемадзейнічаць з іншымі сховішчамі."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per a interactuar amb les vostres altres caixes fortes, heu de millorar el vostre compte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li používat další trezory, musíte svůj účet navýšit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil interagere med dine andre bokse, skal du opgradere din konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mit deinen anderen Tresoren zu interagieren, musst du dein Konto upgraden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να αλληλεπιδράσετε με τις κρύπτες, πρέπει να αναβαθμίσετε τον λογαριασμό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To interact with your other vaults, you need to upgrade your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para interactuar con tus otras cajas fuertes, necesitas actualizar tu cuenta."
