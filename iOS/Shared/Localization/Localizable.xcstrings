    "You can't invite people outside of your organization, contact admin for more info." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас няма магчымасці запрашаць карыстальнікаў па-за межамі вашай арганізацыі. Звяжыцеся з адміністратарам, каб атрымаць дадатковыя звесткі."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
