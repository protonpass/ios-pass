    "Unlock advanced security features and detailed logs to safeguard your online presence." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разблакіруйце дадатковыя функцыі бяспекі і падрабязныя журналы для абароны сваёй прысутнасці ў інтэрнэце."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquegeu característiques de seguretat avançades i registres detallats per protegir la vostra presència en línia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemkněte pokročilé funkce zabezpečení a podrobné logy, abyste zabezpečili svou online přítomnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås op for avancerede sikkerhedsfunktioner og detaljerede logfiler for at beskytte din online tilstedeværelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte erweiterte Sicherheitsfunktionen und detaillierte Protokolle zum Schutz deiner Online-Präsenz frei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκλειδώστε προηγμένες λειτουργίες ασφαλείας και λεπτομερή αρχεία καταγραφής για να προστατεύσετε την παρουσία σας στο διαδίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock advanced security features and detailed logs to safeguard your online presence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea funciones de seguridad avanzadas y registros detallados para proteger tu presencia en línea."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquee funciones de seguridad avanzadas y registros detallados para proteger su presencia en línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa edistyneet suojausominaisuudet ja yksityiskohtaiset lokit verkkonäkyvyytesi suojaamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquez des fonctionnalités de sécurité avancée et journaux détaillés pour protéger votre présence en ligne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejlett biztonsági funkciók és részletes naplófájlok feloldása az online jelenlétének védelme érdekében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan berbagai fitur keamanan mutakhir dan log yang terperinci untuk melindungi presensi online Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca funzionalità di sicurezza avanzate e log dettagliati per proteggere la tua presenza online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高度なセキュリティ機能と詳細なログのロックを解除して、オンライン プレゼンスを保護します。"
          }
