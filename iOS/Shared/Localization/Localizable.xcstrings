    "File attachments are available with Pass Plus. Upgrade for immediate access." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы з далучэннямі даступны з Pass Plus. Палепшыце для неадкладнага доступу."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass Plus permet adjuntar fitxers. Milloreu el vostre pla per obtenir accés immediat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přílohy souborů jsou k dispozici v Pass Plus. Navyšte tarif pro okamžitý přístup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fil-vedhæftninger er tilgængelig med Pass Plus. Opgrader for at få adgang med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateianhänge sind mit Pass Plus verfügbar. Upgrade für sofortigen Zugriff."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα συνημμένα αρχεία είναι διαθέσιμα με το Pass Plus. Αναβαθμίστε για άμεση πρόσβαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File attachments are available with Pass Plus. Upgrade for immediate access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass Plus permite adjuntar archivos. Mejora tu plan para obtener acceso inmediato."
