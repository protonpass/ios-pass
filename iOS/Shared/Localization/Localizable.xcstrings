          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias \"%@\" ei enää ohjaa viestejä postilaatikkoosi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'alias « %@ » ne transférera plus les messages vers votre messagerie."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
