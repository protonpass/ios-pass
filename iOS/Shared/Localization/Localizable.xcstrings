    "Alias \"%@\" will stop forwarding emails to your mailbox" : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псеўданім \"%@\" перастане перасылаць лісты ў вашу паштовую скрыню"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'àlies \"%@\" deixarà de reenviar correus electrònics a la vostra bústia de correu"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias \"%@\" přestane přeposílat e-maily do vaší schránky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasset \"%@\" vil stoppe med at videresende e-mails til din indbakke"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias \"%@\" wird keine E-Mails mehr an dein Postfach weiterleiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ψευδώνυμο \"%@\" θα σταματήσει να προωθεί μηνύματα ηλεκτρονικού ταχυδρομείου στο γραμματοκιβώτιό σας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias \"%@\" will stop forwarding emails to your mailbox"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El alias \"%@\" dejará de reenviar correos a tu buzón."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El alias \"%@\" dejará de reenviar correos a el buzón."
          }
        },
