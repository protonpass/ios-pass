    "In Pass, an item note is encrypted with the item encryption key and only users who have access to the item can view the note." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Pass нататка элемента зашыфравана ключом шыфравання элемента, і паглядзець яе могуць толькі карыстальнікі, якія маюць доступ да элемента."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Pass, una nota d'element es xifra amb la clau de xifratge de l'element i només els usuaris que tenen accés a l'element poden veure la nota."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V aplikaci Pass je poznámka k položce zašifrována šifrovacím klíčem položky a mohou ji zobrazit pouze uživatelé, kteří mají k položce přístup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Pass er en element-note krypteret med elementets krypteringsnøgle, og kun brugere, der har adgang til elementet, kan se noten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Pass wird eine Eintragsnotiz mit einem individuellen Schlüssel verschlüsselt und nur Benutzer, die Zugriff auf den Eintrag haben, können die Notiz einsehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο Pass, μια σημείωση στοιχείου κρυπτογραφείται με το κλειδί κρυπτογράφησης στοιχείου και μόνο οι χρήστες που έχουν πρόσβαση στο στοιχείο μπορούν να δουν τη σημείωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Pass, an item note is encrypted with the item encryption key and only users who have access to the item can view the note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Pass, una nota se encripta con una clave de encriptación y solo los usuarios que tienen acceso a la nota pueden verla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Pass, una nota se cifra con la clave de cifrado de esa nota y solo los usuarios que tienen acceso a la nota pueden verla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass-kohteiden muistiinpanot salataan kohteiden salausavaimilla ja vain niiden käyttöoikeuden omaavat käyttäjät voivat tarkastella muistiinpanoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Pass, la note d'un élément est chiffrée avec la clé de chiffrement de l'élément et seuls les utilisateurs ayant accès à l'élément peuvent voir la note."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Passban az elem megjegyzését az elem titkosítási kulcsa titkosítja, és csak azok a felhasználók láthatják a megjegyzést, akiknek hozzáférése van az elemhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada Pass, catatan item akan terenkripsi oleh kunci enkripsi item dan hanya akan dapat dilihat oleh para pengguna yang memiliki akses ke item."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Pass, una nota dell'elemento viene crittografata con la chiave di crittografia dell'elemento e solo gli utenti che hanno accesso all'elemento possono visualizzare la nota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passでは、アイテムノートはアイテム暗号化キーによって暗号化され、ノートを閲覧できるのはアクセス権を持ったユーザーだけです。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass-ში ელემენტის შენიშვნა ელემენტთან ერთად იშიფრება და, მხოლოდ, მომხმარებლებს, რომლებსაც აქვთ წვდომა ელემენთან, აქვთ წვდომა შენიშვნასთან."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass에서 메모 항목이 암호화 키로 암호화되었으며 이 항목에 접근 가능한 사용자만 메모 확인 가능합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Pass krypteres et elementnotat med elementkrypteringsnøkkelen, og bare brukere som har tilgang til elementet, kan se notatet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Pass is een artikelnotitie versleuteld met de artikelversleutelingssleutel en alleen gebruikers die toegang hebben tot het item kunnen de notitie bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Proton Pass notatka elementu jest szyfrowana za pomocą klucza szyfrowania elementu i tylko użytkownicy, którzy mają dostęp do elementu, mogą ją wyświetlić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Pass, uma nota de item é encriptada com a chave de encriptação do item e apenas os utilizadores com acesso ao item podem visualizar a nota."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Pass, uma nota de item é criptografada com a chave de criptografia do item e somente usuários com acesso ao item podem visualizar a nota."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În aplicația Pass, o notiță este criptată cu cheia de criptare a acesteia și numai utilizatorii care au acces la ea o pot vizualiza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Pass заметка элемента зашифрована ключом шифрования элемента, и просмотреть ее могут только пользователи, имеющие доступ к элементу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V aplikácii Pass je poznámka k položke zašifrovaná pomocou šifrovacieho kľúča položky a poznámku môžu zobraziť len používatelia, ktorí majú prístup k položke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Pass så objektanteckning krypterad med objektets krypteringsnyckel och endast användare som har tillgång till objektet kan se anteckningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Pass uygulamasında bir öge notu, öge şifreleme anahtarıyla şifrelenir ve yalnızca ögeye erişim izni olan kullanıcılar notu görüntüleyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Pass примітка до елемента шифрується за допомогою ключа шифрування елемента, і тільки користувачі, які мають доступ до елемента, можуть переглянути примітку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong Pass, một ghi chú mục được mã hóa bằng khóa mã hóa mục và chỉ những người dùng có quyền truy cập vào mục mới có thể xem ghi chú."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Pass 中，项目笔记使用项目加密密钥进行加密，只有有权访问项目的用户才能查看备注。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Pass 中，項目筆記會以項目加密金鑰加密，只有擁有該項目存取權的使用者才能查看筆記。"
          }
        }
      }
    },
