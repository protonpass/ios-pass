    "Dark Web Monitoring is available with a paid plan. Upgrade for immediate access." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функцыя Dark Web Monitoring даступна з платным тарыфным планам. Палепшыце сваю падпіску, каб неадкладна атрымаць доступ да гэтай функцыі."
          }
        },
        "ca" : {
          "stringUnit" : {
