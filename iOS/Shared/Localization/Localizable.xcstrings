    "Some vaults are no longer accessible due to a password reset. Reactivate your account keys in order to regain access." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Па прычыне скінутага пароля некаторыя сховішчы больш недаступны. Паўторна актывуйце ключы свайго ўліковага запісу, каб аднавіць доступ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dipòsits ja no són accessibles a causa d'un restabliment de contrasenya. Reactiveu les claus del vostre compte per recuperar l'accés."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé trezory již nejsou přístupné z důvodu resetu hesla. Znovu aktivujte klíče svého účtu pro obnovení přístupu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle bokse er ikke længere tilgængelige på grund af en nulstilling af adgangskoden. Genaktiver dine kontonøgler for at få adgang igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Tresore sind aufgrund eines Passwortzurücksetzens nicht mehr zugänglich. Reaktiviere deine Kontoschlüssel, um wieder Zugriff zu erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάποιες κρύπτες δεν είναι πλέον προσβάσιμες λόγω επαναφοράς κωδικού. Ενεργοποιήστε ξανά τα κλειδιά του λογαριασμού σας για να αποκτήσετε ξανά πρόσβαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some vaults are no longer accessible due to a password reset. Reactivate your account keys in order to regain access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas cajas fuertes ya no son accesibles debido a un restablecimiento de la contraseña. Reactiva las claves de tu cuenta para recuperar el acceso."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas bóvedas ya no son accesibles debido a un restablecimiento de contraseña. Reactive sus claves de cuenta para recuperar el acceso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkin holvit eivät ole enää saatavilla salasanan nollaamisen vuoksi. Uudelleenaktivoi tilisi avaimet palauttaaksesi pääsyn holveihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains coffres-forts ne sont plus accessibles suite à une réinitialisation du mot de passe. Réactivez les clés de votre compte afin de retrouver l'accès."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány tároló már nem hozzáférhető egy jelszó-visszaállítás miatt. Aktiválja újra a fiók kulcsait a hozzáférés újbóli megszerzéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa brankas tidak lagi dapat diakses karena kata sandi diatur ulang. Aktifkan kembali kunci akun Anda agar dapat mengakses kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune casseforti non sono più accessibili a causa di un reset della password. Riattiva le chiavi del tuo account per recuperare l'accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードリセットにより、一部保管庫にアクセスできなくなりました。アカウントキーを再アクティブ化して、アクセスを回復してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 금고가 비밀번호 재설정으로 인해 접근할 수 없습니다. 다시 접근하려면 계정 키를 다시 활성화해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen hvelv er ikke lenger tilgjengelige på grunn av tilbakestilling av passord. Aktiver kontonøklene på nytt for å få tilgang igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige kluizen zijn niet meer toegankelijk vanwege een wachtwoordreset. Activeer uw accountkeys opnieuw om weer toegang te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre sejfy nie są już dostępne z powodu zresetowania hasła. Reaktywuj klucze konta, aby odzyskać dostęp."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns cofres já não estão acessíveis devido a uma reposição da palavra-passe. Reative as chaves da sua conta para recuperar o acesso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns cofres não estão mais acessíveis devido a uma redefinição de senha. Reative as chaves de sua conta para recuperar o acesso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unele seifuri nu mai sunt accesibile datorită unei resetări a parolei. Reactivați cheile contului pentru a redobândi accesul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые хранилища больше недоступны из-за сброса пароля. Чтобы восстановить доступ, активируйте ключи аккаунта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré trezory už nie sú prístupné z dôvodu obnovenia hesla. Ak chcete opätovne získať prístup, znovu aktivujte kľúče svojho účtu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Några valv är inte längre åtkomliga på grund av en lösenordsåterställning. Återaktivera dina kontonycklar för att få åtkomst igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir parola sıfırlama işlemi nedeniyle bazı kasalara artık erişilemiyor. Bunlara yeniden erişebilmek için hesap anahtarlarınızı yeniden etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі сховища більше не доступні через скидання пароля. Повторно активуйте ключі облікового запису, щоб відновити доступ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于密码重置，有些保险库已无法访问。请重新激活您的账户密钥，以重新获得访问权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些保管庫於密碼重設後無法使用。重新啟用帳號密鑰已重新取得權限。"
          }
        }
      }
    },
